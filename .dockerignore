# Bundler root .dockerignore: keep the build context lean and keep
# secrets / local state out of the image. Mirrors .gitignore plus
# anything that must never reach a layer.

# Version control
.git
.gitignore

# Worktrees and local clones
.worktrees/

# Build artifacts (compiled JS output; Bun runs TS source directly)
dist/
*.tgz

# Dependencies (installed inside the image from lock files, not
# copied from the host)
node_modules/
**/node_modules/

# Secrets and local state: never bake into an image
.env
.env.*
!.env.example
.lb/
**/.lb/

# Persistent runtime state (lives on the /data volume, not in layers)
*.db
*.sqlite
*.sqlite3
**/sessions/
**/child-registry.json
**/credentials/

# Docs are build-time documentation only; the agent folder sample
# in template/ is the runtime surface and is copied explicitly.
docs/
README.md

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
