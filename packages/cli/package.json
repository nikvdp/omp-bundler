{
  "name": "@omp-bundler/cli",
  "version": "0.1.0",
  "description": "Build and run filesystem-configured OMP agents as a durable service",
  "type": "module",
  "bin": {
    "omp-bundler": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "src/**",
    "assets/**"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/cli.test.mjs",
    "prepack": "bun scripts/prepack.ts",
    "compile": "bun scripts/compile.ts"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/yargs": "^17.0.35",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  }
}
