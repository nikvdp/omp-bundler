{
  "name": "@omp-bundler/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./src/shared.ts",
      "default": "./dist/shared.js"
    },
    "./inbound": {
      "types": "./src/inbound.ts",
      "import": "./src/inbound.ts",
      "default": "./dist/inbound.js"
    },
    "./outbound": {
      "types": "./src/outbound.ts",
      "import": "./src/outbound.ts",
      "default": "./dist/outbound.js"
    },
    "./schemas/inbound-v1.json": "./schemas/inbound-v1.json",
    "./schemas/inbound-accepted-v1.json": "./schemas/inbound-accepted-v1.json",
    "./schemas/outbound-v1.json": "./schemas/outbound-v1.json"
  },
  "files": [
    "src",
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/contracts.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
