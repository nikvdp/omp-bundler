{
  "name": "pumble-adapter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "import": "./src/manifest.ts"
    },
    "./security": {
      "types": "./src/security.ts",
      "import": "./src/security.ts"
    },
    "./pumble-api": {
      "types": "./src/pumble-api.ts",
      "import": "./src/pumble-api.ts"
    },
    "./pumble-event": {
      "types": "./src/pumble-event.ts",
      "import": "./src/pumble-event.ts"
    },
    "./pumble-files": {
      "types": "./src/pumble-files.ts",
      "import": "./src/pumble-files.ts"
    },
    "./pumble-renderer": {
      "types": "./src/pumble-renderer.ts",
      "import": "./src/pumble-renderer.ts"
    },
    "./attachment-sender": {
      "types": "./src/attachment-sender.ts",
      "import": "./src/attachment-sender.ts"
    },
    "./delivery-store": {
      "types": "./src/delivery-store.ts",
      "import": "./src/delivery-store.ts"
    },
    "./target-store": {
      "types": "./src/target-store.ts",
      "import": "./src/target-store.ts"
    },
    "./token-store": {
      "types": "./src/token-store.ts",
      "import": "./src/token-store.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun src/server.ts"
  },
  "dependencies": {
    "@omp-bundler/contracts": "file:../contracts"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
