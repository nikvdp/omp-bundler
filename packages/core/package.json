{
  "name": "@omp-bundler/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/rpc-child.ts",
      "import": "./src/rpc-child.ts",
      "default": "./dist/rpc-child.js"
    },
    "./rpc-child": {
      "types": "./src/rpc-child.ts",
      "import": "./src/rpc-child.ts",
      "default": "./dist/rpc-child.js"
    },
    "./child-reaper": {
      "types": "./src/child-reaper.ts",
      "import": "./src/child-reaper.ts",
      "default": "./dist/child-reaper.js"
    },
    "./adapter-registry": {
      "types": "./src/adapter-registry.ts",
      "import": "./src/adapter-registry.ts",
      "default": "./dist/adapter-registry.js"
    },
    "./idempotency-store": {
      "types": "./src/idempotency-store.ts",
      "import": "./src/idempotency-store.ts",
      "default": "./dist/idempotency-store.js"
    },
    "./ingest-buffer": {
      "types": "./src/ingest-buffer.ts",
      "import": "./src/ingest-buffer.ts",
      "default": "./dist/ingest-buffer.js"
    },
    "./pool-manager": {
      "types": "./src/pool-manager.ts",
      "import": "./src/pool-manager.ts",
      "default": "./dist/pool-manager.js"
    },
    "./session-registry": {
      "types": "./src/session-registry.ts",
      "import": "./src/session-registry.ts",
      "default": "./dist/session-registry.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./dist/config.js"
