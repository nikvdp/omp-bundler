  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@omp-bundler/contracts": "file:../contracts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.6.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
